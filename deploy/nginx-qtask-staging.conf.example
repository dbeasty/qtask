# Optional staging vhost for candidate stack testing (port 3005).
# App ports 3003/3005 are usually blocked from client VLANs by UniFi/firewall;
# proxy candidate through nginx on 443 (same pattern as admin.qtask.dev).
#
# 1. Local DNS: staging.qtask.dev → 192.168.13.13 (UniFi / Pi-hole — no public DNS)
# 2. sudo cp deploy/nginx-qtask-staging.conf.example /etc/nginx/sites-available/qtask-staging
# 3. sudo ln -s /etc/nginx/sites-available/qtask-staging /etc/nginx/sites-enabled/
# 4. sudo nginx -t && sudo systemctl reload nginx
# 5. curl -sk --resolve staging.qtask.dev:443:192.168.13.13 https://staging.qtask.dev/health
#
# SSH tunnel alternative (no nginx): ssh -L 3005:127.0.0.1:3005 qtask@192.168.13.13

server {
    listen 192.168.13.13:443 ssl http2;
    server_name staging.qtask.dev;

    ssl_certificate     /etc/nginx/ssl/qtask.pem;
    ssl_certificate_key /etc/nginx/ssl/qtask.key;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 192.168.13.13:443 ssl http2;
    server_name staging-admin.qtask.dev;

    ssl_certificate     /etc/nginx/ssl/qtask.pem;
    ssl_certificate_key /etc/nginx/ssl/qtask.key;

    location / {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
