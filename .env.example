# Server
PORT=3000
NODE_ENV=development

# Secrets source: env (default) | vault (optional HashiCorp Vault)
SECRETS_BACKEND=env
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_SECRET_PATH=secret/data/qtask/production
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# MongoDB (local dev — no auth; 127.0.0.1 avoids IPv6 localhost issues with Docker on macOS)
# --- Data backend ---------------------------------------------------------
# MongoDB is the default and is what every deployment should run today. Leaving
# both flags unset resolves to Mongo; DATA_MONGO=true just says so out loud.
#
# Setting both is a startup error rather than a precedence puzzle: with two
# stores wired up, silently picking one means half a deployment could be
# reading from the other.
DATA_MONGO=true

# KDB is implemented and passes the same conformance suite as Mongo, but it has
# had no production exposure. Do not turn this on outside development without
# working through the shadow-write and shadow-read stages first.
# DATA_KDB=true
# KDB_ADDR=tcp://127.0.0.1:7700
# KDB_NAMESPACE_PREFIX=qtask
# KDB_TOKEN=

# Shadow writes (migration stage 2). Every write also goes to the *other* backend;
# the one selected above still answers every read and owns every result. The
# request never waits on the shadow and never fails because of it — a shadow that
# errors, stalls or will not connect is logged and counted, not raised.
#
# This is how the candidate backend gets its first real write traffic. Watch
# `data.shadow` on /health: `failed` means it cannot keep up semantically,
# `dropped` means it cannot keep up at all and is now knowingly stale.
# DATA_SHADOW_WRITES=true

# Shadow reads (migration stage 3). Asks the shadow the same questions and reports
# where the answers differ. The primary still serves every request, so a divergence
# is a bug report rather than an incident — this is the evidence that decides
# whether the backend has earned a read flip.
#
# Requires DATA_SHADOW_WRITES; without mirrored writes the shadow holds no data and
# every read would "diverge". Setting it alone is a startup error, not a silent no-op.
#
# Watch `data.reads` on /health. `diverged` is the number a bake gates on.
# `unordered` counts queries that asked for no sort and got the same documents in a
# different order: not a disagreement, but a caller relying on that order would
# behave differently after a flip.
# DATA_SHADOW_READS=true

# Fraction of reads to compare, 0..1. Defaults to 1 — a bake that silently sampled
# 1% would look far cleaner than the evidence supports. Dial it down when comparing
# every read costs too much, remembering that KDB scans where Mongo indexes.
# DATA_SHADOW_READ_SAMPLE=0.1

MONGODB_URI=mongodb://127.0.0.1:27017/qtask
# Optional host-volume encryption (production standalone; default off)
MONGO_ENCRYPT_AT_REST=false

# Authentication (required in production when SECRETS_BACKEND=env)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MCP OAuth (Claude web connectors; required in production)
MCP_OAUTH_ENABLED=true
MCP_OAUTH_JWT_SECRET=change-me-to-a-long-random-string
# MCP_OAUTH_ACCESS_TOKEN_TTL_SEC=3600

# CORS — web client origin in development
CORS_ORIGIN=http://localhost:5173

# Public web app URL (used in verification and password-reset email links)
APP_URL=http://localhost:5173

# Production example (uncomment and adjust if deploying to qtask.dev):
# CORS_ORIGIN=https://qtask.dev
# APP_URL=https://qtask.dev

# Mail provider (optional for startup; required in production for registration/password-reset emails)
# Prefer Resend (HTTP API). Set MAIL_RESEND=true and RESEND_API_KEY.
# Or use SMTP with MAIL_SMTP=true and SMTP_* vars. If both flags are true, Resend wins.
# Backward compat: SMTP_HOST alone still enables SMTP when neither flag is set.
MAIL_RESEND=false
RESEND_API_KEY=
RESEND_FROM=noreply@qtask.dev

MAIL_SMTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@qtask.dev

# Set to false to close new account creation (capacity / ops). Restart after changing.
REGISTRATION_ENABLED=true

# Set to true when behind a reverse proxy (Caddy/nginx)
TRUST_PROXY=false

# Serve built React client from the API in production
SERVE_CLIENT=true

# Ollama (local SLM + embeddings). For Jetson LAN / Compose, see docs/DEPLOY.md
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=-1
OLLAMA_EMBEDDING_KEEP_ALIVE=-1
OLLAMA_EMBEDDING_NUM_GPU=0
# Feedback screenshots (Help page). Vision Ollama on app server; agent stays on Jetson.
# FEEDBACK_ENABLED=true
# FEEDBACK_IMAGES_ENABLED=true
# OLLAMA_VISION_BASE_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=moondream
# STORAGE_BACKEND=local
# STORAGE_LOCAL_PATH=./data/uploads
# Agent find_tasks hybrid search (semantic + text). Set false to skip Ollama embeddings in agent only.
# AGENT_HYBRID_SEARCH=true

# Standalone admin application (port should remain behind a firewall / loopback proxy)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3004
ADMIN_AUTH_MODE=password
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
# Optional: store bcrypt hash instead of plaintext (npm run hash-admin-password)
# HASH_ADMIN_PASSWORD=true
# ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=change-me-to-a-separate-long-random-string
# For ADMIN_AUTH_MODE=mtls, configure nginx client verification and set:
ADMIN_PROXY_SECRET=
ADMIN_COOKIE_SECURE=false
# Require typing the user email before admin delete (default: off)
# ADMIN_DELETE_CONFIRM_EMAIL=true
LLM_METRICS_RETENTION_DAYS=30
# Optional live Ollama resource collectors:
OLLAMA_DOCKER_STATS_URL=
OLLAMA_DOCKER_CONTAINER=qtask-ollama
DCGM_METRICS_URL=
# Jetson GPU stats sidecar (on-demand sysfs reader on the Jetson host):
# JETSON_GPU_STATS_URL=http://192.168.13.14:9401/gpu

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# Social sign-in (OIDC) — each provider requires OAUTH_{PROVIDER}_ENABLED=true plus client credentials
# OAUTH_GOOGLE_ENABLED=false
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_ENABLED=false
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT_ID=common
# API_PUBLIC_URL=https://qtask.dev

# Deployment / A/B stack (production — set by qtask-deploy; do not enable manually in dev)
# READ_ONLY_MODE=false
# DEPLOYMENT_PHASE=normal
# DEPLOYMENT_MESSAGE=Edits are temporarily disabled while we deploy a major update.
# EMBEDDING_WORKER_ENABLED=true
# STORAGE_LOCAL_PATH=/var/lib/qtask/uploads

# MCP in Cursor — set to a JWT from POST /api/auth/login
# MCP_JWT=eyJ...
